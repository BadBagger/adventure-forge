{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adventureforge.local/forge-project.schema.json",
  "title": "AdventureForge Project",
  "description": "Primary AdventureForge authoring/export format consumed by the shared runtime core, editor preview, and standalone playable builder.",
  "type": "object",
  "required": ["version", "name", "activeSceneId", "scenes", "assets"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "slug": { "type": "string" },
    "activeSceneId": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "object",
      "properties": {
        "characters": {
          "type": "array",
          "items": { "$ref": "#/$defs/characterModel" }
        },
        "castAnimationLibrary": { "type": "object" }
      },
      "additionalProperties": true
    },
    "script": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "array",
          "items": { "$ref": "#/$defs/scriptLine" }
        }
      },
      "additionalProperties": true
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    },
    "export": { "type": "object" },
    "game": { "type": "object" }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "minimum": 0 },
        "h": { "type": "number", "minimum": 0 },
        "baseline": { "type": "number" }
      },
      "additionalProperties": true
    },
    "scene": {
      "type": "object",
      "required": ["id", "name", "width", "height", "layers", "objects"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "enum": ["background", "midground", "foreground", "prop", "occlusion"] },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "w": { "type": "number", "minimum": 0 },
              "h": { "type": "number", "minimum": 0 },
              "baseline": { "type": "number" },
              "visible": { "type": "boolean" },
              "image": { "type": "string" },
              "dataUrl": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "allOf": [{ "$ref": "#/$defs/rect" }],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["character", "hitbox", "dialogue", "walkable", "prop"] },
              "modelId": { "type": "string" },
              "targetSceneId": { "type": "string" },
              "hotspotId": { "type": "string" }
            }
          }
        },
        "dialogue": { "type": "array" },
        "flags": { "type": "object" },
        "locked": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "characterModel": {
      "type": "object",
      "required": ["id", "name", "frames", "animations"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "frames": { "type": "array" },
        "animations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["frames", "fps", "loop"],
            "properties": {
              "frames": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0 }
              },
              "fps": { "type": "number", "exclusiveMinimum": 0 },
              "loop": { "type": "boolean" },
              "holds": {
                "type": "array",
                "items": { "type": "number", "exclusiveMinimum": 0 }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "scriptLine": {
      "type": "object",
      "required": ["line_id", "text"],
      "properties": {
        "line_id": { "type": "string", "minLength": 1 },
        "speaker": { "type": "string" },
        "text": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
